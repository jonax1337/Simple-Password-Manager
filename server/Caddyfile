# Auto-TLS via Let's Encrypt. Caddy provisions the cert on first request
# and renews ~30 days before expiry. ACME_EMAIL is used for recovery and
# expiry notifications.
{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    # Strict transport security: tell browsers to refuse plain HTTP for a
    # year. Safe because Caddy redirects :80 -> :443 by default.
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin
        # CORS already handled by the vault server itself.
    }

    # Static dashboard SPA. Build with `cd dashboard && npm run build`, then
    # bind-mount the resulting dist/ at /srv/dashboard in the caddy service.
    handle_path /dashboard/* {
        root * /srv/dashboard
        try_files {path} /index.html
        file_server
    }

    # API: everything else proxies to the vault server.
    handle {
        reverse_proxy vault:8090 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
        }
    }
}
