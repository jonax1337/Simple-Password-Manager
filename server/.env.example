# Required: the hostname your DNS A/AAAA record points at.
# Caddy uses this both for the vhost match and the Let's Encrypt cert.
DOMAIN=vault.example.com

# Required: email Let's Encrypt sends expiry warnings to.
ACME_EMAIL=you@example.com

# Optional: tracing filter. "info" is sensible; "debug" if you're chasing a bug.
RUST_LOG=info
